            /* Find LRU page */
            if (replace == -1)
            {
                replace = 0;

                for (j = 1; j < frameCount; j++)
                {
                    if (recent[j] < recent[replace])
                        replace = j;
                }
            }

            frames[replace] = page;
            recent[replace] = time;

            printf("%d\tPage Fault\t", page);
        }

        /* Display frames */
        for (j = 0; j < frameCount; j++)
        {
            if (frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        printf("\n");
    }

    printf("--------------------------------\n");
    printf("Total Page Hits   = %d\n", pageHits);
    printf("Total Page Faults = %d\n", pageFaults);

    return 0;
}
